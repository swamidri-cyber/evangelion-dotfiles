# Tema del rice para micro — Gruvbox ámbar. Fondo "default" = el de la terminal.
color-link default "#ebdbb2,default"
color-link comment "#928374"
color-link symbol "#fe8019"
color-link constant "#d3869b"
color-link constant.string "#b8bb26"
color-link constant.string.char "#b8bb26"
color-link identifier "#83a598"
color-link statement "#fb4934"
color-link preproc "#8ec07c"
color-link type "#fabd2f"
color-link special "#fe8019"
color-link underlined "underline #83a598"
color-link error "bold #fb4934"
color-link todo "bold #fabd2f"
color-link hlsearch "#0d0b09,#fabd2f"
color-link statusline "#0d0b09,#d65d0e"
color-link tabbar "#a89984,#1d2021"
color-link indent-char "#3c3836"
color-link line-number "#665c54,default"
color-link current-line-number "#fe8019,default"
color-link cursor-line "#1d2021"
color-link color-column "#1d2021"
color-link selection "#0d0b09,#fe8019"
color-link diff-added "#b8bb26"
color-link diff-modified "#fabd2f"
color-link diff-deleted "#fb4934"
color-link gutter-error "#fb4934"
color-link gutter-warning "#fabd2f"
color-link scrollbar "#504945"
color-link match-brace "#0d0b09,#fe8019"
